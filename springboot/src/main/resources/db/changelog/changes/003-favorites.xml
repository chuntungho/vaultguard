<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="003-01-create-favorites" author="vaultguard">
        <createTable tableName="favorites">
            <column name="user_uuid" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="cipher_uuid" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="favorites" columnNames="user_uuid, cipher_uuid"
                       constraintName="pk_favorites"/>
    </changeSet>

    <changeSet id="003-02-favorites-cipher-index" author="vaultguard">
        <createIndex tableName="favorites" indexName="idx_favorites_cipher">
            <column name="cipher_uuid"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
